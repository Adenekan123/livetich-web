# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
.agents/

# tooling cache + stray asset (not for the repo)
.impeccable/
public/livetich lgog.png

# playwright e2e
/test-results/
/playwright-report/
/e2e/.auth/
/e2e/fixtures/

# Explainer-video draft recordings (large binaries). Anchored to the repo root:
# unanchored, this also swallowed src/app/recordings/, so the gallery route
# worked locally and simply did not exist in a fresh clone.
/recordings/

# Excalidraw runtime fonts — regenerated by scripts/copy-excalidraw-assets.mjs
public/excalidraw-assets/

# Scratch & temporary testing data
scratch/
temp-vscode-user-data/
scripts/test_grading.png
